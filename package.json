{
  "name": "transport-logistics-app",
  "private": true,
  "version": "1.0.0",
  "description": "Веб-приложение для автоматизации деятельности транспортной компании по грузоперевозкам",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "server": "node server/index.mjs",
    "client": "vite",
    "build": "tsc -b && vite build",
    "build:portable": "vite build --config vite.portable.config.ts",
    "cap:sync": "npm run build && npx cap sync android",
    "start": "node server/index.mjs",
    "lint": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^5.0.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.8.3",
    "vite": "^7.1.0",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
